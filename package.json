{
  "name": "trafalgar-1805",
  "version": "0.1.0",
  "private": true,
  "description": "A scroll-driven, cinematic telling of the Battle of Trafalgar, 21 October 1805.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "postbuild": "node scripts/dev/build-stamp.mjs",
    "preview": "serve out --listen tcp://127.0.0.1:4173 --no-clipboard --no-port-switching",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "npm run build && playwright test --project=laptop --project=desktop-1080 --project=phone --project=perf --project=chart --project=chart-gpu --project=road --project=regression --project=chart-frames",
    "screenshots": "npm run build && playwright test --project=docs",
    "screenshots:chart": "npm run build && playwright test --project=docs-chart",
    "check:lettering": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-lettering.ts",
    "check": "npm run lint && npm run typecheck && npm run check:lettering && npm run test:e2e",
    "data:download": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/download.ts",
    "data:build": "npm run data:download && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/build.ts",
    "data:soundings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/soundings.ts",
    "deploy": "npm run build && wrangler deploy",
    "stills": "npm run build && playwright test --project=stills"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "troika-three-text": "0.52.5",
    "troika-three-utils": "0.52.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "netcdfjs": "4.0.0",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
