{
  "name": "trafalgar-1805",
  "version": "0.1.0",
  "private": true,
  "description": "A scroll-driven, cinematic telling of the Battle of Trafalgar, 21 October 1805.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "preview": "serve out --listen tcp://127.0.0.1:4173 --no-clipboard",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:e2e",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
